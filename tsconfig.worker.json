{
  // Typechecks the Cloudflare entry with Workers runtime types (from `wrangler types`), not @types/node.
  // Wrangler bundles the Worker itself; this config only checks it.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/worker/**/*.ts"]
}
