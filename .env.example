# Copy to .env and fill in. Keys stay server-side; never commit .env.
# Qloo hackathon key (https://hackathon.api.qloo.com). Without it the app runs on synthetic stand-in data.
QLOO_API_KEY=
# TMDB v4 read access token (episode runtimes and add-show search). Optional; without it shows default to 45 min.
TMDB_READ_ACCESS_TOKEN=
# Anthropic key for the Claude agent and "vs AI alone". Optional; without it the agent is hidden.
ANTHROPIC_API_KEY=
# Optional
# PORT=8080
# QLOO_CACHE_FILE=data/qloo-cache.json
# Deploying to Cloudflare: your account ID, so wrangler never prompts when you're logged into several accounts.
# CLOUDFLARE_ACCOUNT_ID=
